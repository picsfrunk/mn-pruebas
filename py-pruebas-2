import numpy as np

A = np.array([[4, 1, -1],
              [3, 5, 1],
              [1, -2, 6]])

# Vector de términos independientes
b = np.array([5, -2, 7])

print("A:\n", A)
print("b:\n", b)
k = 100

D = np.diag(np.diag(A))
LU = A - D
n = len(A)
x = np.zeros(n)
H = []
norm = []
tol = 1e-4

for i in range(k):
    D_inv = np.linalg.inv(D)
    x_temp = x
    x = np.dot(D_inv, np.dot(-LU, x_temp)) + np.dot(D_inv, b)
    H.append(x)
    if i != 1:
        e = np.linalg.norm(x - x_temp)
        norm.append(e)
    if e < tol:
        break

# t = range(len(H))
for i in range(len(norm)-1):
    print("===================================================================")
    print("Iteracion ", i+1)
    print("Vector solucion temporal:\n", H[i], "\n")
    print("Norma:\n", norm[i], "\n")
print("===================================================================")
print("Resultado Final: ", x)
